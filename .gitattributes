# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary

# Data files
*.csv binary
*.npz binary
*.npy binary